# @PROJECT@ — the per-game sibling repo for @NAME@ on n64lle.
#
# Scaffolded by n64lle tools/new_project/setup_project.sh on @DATE@.
#
# WHY THIS IS A SUPERBUILD AND NOT add_subdirectory(n64lle)
# ---------------------------------------------------------
# n64lle's bench/ and n64ref/ still resolve some of their own paths through
# CMAKE_SOURCE_DIR rather than the framework's project root. Under
# add_subdirectory() CMAKE_SOURCE_DIR is *this* repo, so those includes point at
# a directory that does not exist. So the framework is BUILT OUT OF TREE by
# tools/build_framework.sh and consumed by path — the pattern n64lle itself uses
# for Ares. When that sweep lands upstream, the change goes in the framework's
# runtime/runtime.cmake and this file keeps its one call unchanged.
#
# The submodules stay pristine: no local edits, only a committed .patch applied
# at CMake time if one is ever needed.

cmake_minimum_required(VERSION 3.20)

project(@PROJECT@
  VERSION 0.0.1
  DESCRIPTION "@NAME@ on the n64lle LLE static recompiler"
  LANGUAGES C CXX)

set(CMAKE_C_STANDARD 17)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
  set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()

enable_testing()

# ---------------------------------------------------------------------------
# The framework. n64lle_runtime_resolve_framework() locates the pre-built
# libraries and tools and sets N64LLE_ROOT / _BUILD / _LIBS / _HARVEST / _EMIT /
# _SUPPORT / _ISA_INC, failing with the exact command to run when any is
# missing. It lives in the framework so every port resolves it the same way.
# ---------------------------------------------------------------------------
set(N64LLE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/n64lle" CACHE PATH
    "n64lle submodule source root")
set(N64LLE_BUILD "${CMAKE_CURRENT_SOURCE_DIR}/build-n64lle" CACHE PATH
    "Directory containing the pre-built n64lle libraries and tools")

include("${N64LLE_ROOT}/runtime/runtime.cmake")
n64lle_runtime_resolve_framework("${N64LLE_ROOT}" "${N64LLE_BUILD}")

# ---------------------------------------------------------------------------
# The ROM. Never committed (.gitignore); staged locally by the user.
# ---------------------------------------------------------------------------
set(@SLUG_UPPER@_ROM "${CMAKE_CURRENT_SOURCE_DIR}/@ROM_FILE@" CACHE FILEPATH
    "Path to the user's own @NAME@ dump")

# Mirrors of game.toml [recompiler] — n64lle has no game.toml loader for the
# BUILD yet, so these are the values it actually uses. Keep them in step by hand
# until that loader lands; game.toml marks each mirrored key.
set(@SLUG_UPPER@_HARVEST_FRAMES @HARVEST_FRAMES@ CACHE STRING
    "game.toml [recompiler].harvest_frames")
set(@SLUG_UPPER@_HARVEST_STEP_CAP_M @HARVEST_STEP_CAP_M@ CACHE STRING
    "game.toml [recompiler].harvest_step_cap_millions")

if(NOT EXISTS "${@SLUG_UPPER@_ROM}")
  message(WARNING
    "@PROJECT@: ROM absent at ${@SLUG_UPPER@_ROM}\n"
    "  Stage your own dump there (see roms/README.md). "
    "Recompilation targets are not built; nothing else is affected.")
  return()
endif()

# ---------------------------------------------------------------------------
# The recompilation pipeline: harvest -> emit -> compile.
#
#   n64lle-harvest <rom> <img> <step_cap_M> <frames>   execution-derived discovery
#   n64emit --image <img> <out.c>                      CPS C for the harvested set
#
# N64_RSP_EXEC=1 on the harvest is load-bearing: with RSP execution off, no
# graphics task ever runs and discovery silently under-covers. game.toml records
# the same flag.
# ---------------------------------------------------------------------------
set(_img "${CMAKE_CURRENT_BINARY_DIR}/@SLUG@.n64img")
set(_gen "${CMAKE_CURRENT_SOURCE_DIR}/generated/@SLUG@_generated.c")

add_custom_command(OUTPUT "${_img}"
  COMMAND "${CMAKE_COMMAND}" -E env N64_RSP_EXEC=1
          "${N64LLE_HARVEST}" "${@SLUG_UPPER@_ROM}" "${_img}"
          ${@SLUG_UPPER@_HARVEST_STEP_CAP_M} ${@SLUG_UPPER@_HARVEST_FRAMES}
  DEPENDS "${@SLUG_UPPER@_ROM}"
  COMMENT "@SLUG@: harvesting boot (execution-derived, ${@SLUG_UPPER@_HARVEST_FRAMES}-frame window, RSP live)"
  VERBATIM)

# DEPENDS names the EMITTER as well as the image, for the same reason the
# harvest step above names the harvester: without it a rebuilt n64emit silently
# reuses C that the OLD one produced, and nothing says so. Caught 2026-09-15 --
# an emitter fix was made, the build reported success, and the generated file on
# disk was still the previous emitter's output. rspemit's step already declared
# its tool; this one was the odd one out.
add_custom_command(OUTPUT "${_gen}"
  COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_CURRENT_SOURCE_DIR}/generated"
  COMMAND "${N64LLE_EMIT}" --image "${_img}" "${_gen}"
  DEPENDS "${_img}" "${N64LLE_EMIT}"
  COMMENT "@SLUG@: emitting recompiled C (n64emit --image)"
  VERBATIM)

add_custom_target(@SLUG@-generate DEPENDS "${_gen}")

# Generated output: the framework's -Werror contract does not apply to it.
add_library(@SLUG@_gen STATIC "${_gen}")
add_dependencies(@SLUG@_gen @SLUG@-generate)
target_include_directories(@SLUG@_gen PUBLIC
  "${N64LLE_SUPPORT}"
  "${N64LLE_ROOT}/runtime/include"
  "${N64LLE_ISA_INC}")

# ---------------------------------------------------------------------------
# Gates. These reuse n64lle's own ROM-agnostic drivers against this title's
# generated dispatch table — no forked copies, so a framework fix reaches this
# repo on a submodule bump.
# ---------------------------------------------------------------------------

# Co-simulation gate 1: the compiled tier lockstepped against the interpreter
# floor at interpreter-derived exact cycle boundaries.
add_executable(@SLUG@-cosim
  "${N64LLE_ROOT}/bench/cosim_gate1_driver.c"
  "${N64LLE_SUPPORT}/n64emit_support.c")
target_compile_definitions(@SLUG@-cosim PRIVATE N64_COSIM=1 N64_NO_DEBUG_TOOLS=1)
target_include_directories(@SLUG@-cosim PRIVATE
  "${N64LLE_SUPPORT}" "${N64LLE_ROOT}/runtime/include" "${N64LLE_ISA_INC}")
target_link_libraries(@SLUG@-cosim PRIVATE @SLUG@_gen ${N64LLE_LIBS})

add_test(NAME @SLUG@_cosim_gate1 COMMAND @SLUG@-cosim "${@SLUG_UPPER@_ROM}")
set_tests_properties(@SLUG@_cosim_gate1 PROPERTIES
  PASS_REGULAR_EXPRESSION "GATE1_PASS" FAIL_REGULAR_EXPRESSION "FAIL"
  SKIP_RETURN_CODE 77 TIMEOUT 900)

add_test(NAME @SLUG@_cosim_gate1_rsp COMMAND @SLUG@-cosim "${@SLUG_UPPER@_ROM}")
set_tests_properties(@SLUG@_cosim_gate1_rsp PROPERTIES
  ENVIRONMENT "N64_RSP_EXEC=1"
  PASS_REGULAR_EXPRESSION "GATE1_PASS" FAIL_REGULAR_EXPRESSION "FAIL"
  SKIP_RETURN_CODE 77 TIMEOUT 900)

add_test(NAME @SLUG@_cosim_gate3_inject COMMAND @SLUG@-cosim "${@SLUG_UPPER@_ROM}" --gate3)
set_tests_properties(@SLUG@_cosim_gate3_inject PROPERTIES
  PASS_REGULAR_EXPRESSION "GATE3_PASS" FAIL_REGULAR_EXPRESSION "FAIL"
  SKIP_RETURN_CODE 77 TIMEOUT 900)

add_test(NAME @SLUG@_cosim_gate4_audit COMMAND @SLUG@-cosim "${@SLUG_UPPER@_ROM}" --gate4)
set_tests_properties(@SLUG@_cosim_gate4_audit PROPERTIES
  PASS_REGULAR_EXPRESSION "GATE4_PASS" FAIL_REGULAR_EXPRESSION "FAIL"
  SKIP_RETURN_CODE 77 TIMEOUT 900)

# The paired in-process tier A/B (a measurement tool; the ctest is only a
# pipeline-rot guard). Timing claims come from this, never from a single run,
# and never without stating whether the RSP and rasterizer were live —
# bench_driver does not enable them, so its ratio is CPU-only.
add_executable(@SLUG@-bench
  "${N64LLE_ROOT}/bench/bench_driver.c"
  "${N64LLE_SUPPORT}/n64emit_support.c")
target_include_directories(@SLUG@-bench PRIVATE
  "${N64LLE_SUPPORT}" "${N64LLE_ROOT}/runtime/include" "${N64LLE_ISA_INC}")
target_link_libraries(@SLUG@-bench PRIVATE @SLUG@_gen ${N64LLE_LIBS})

add_test(NAME @SLUG@_bench_smoke COMMAND @SLUG@-bench "${@SLUG_UPPER@_ROM}" 0 1 smoke)
set_tests_properties(@SLUG@_bench_smoke PROPERTIES
  PASS_REGULAR_EXPRESSION "summary:" SKIP_RETURN_CODE 77 TIMEOUT 900)

# ---------------------------------------------------------------------------
# The portable frame probe. n64lle's watchable build is Win32-only, so on Linux
# and macOS there is nothing else that satisfies the family rule "screenshot
# before asserting anything about visible state". This is that, headless: it
# free-runs the ROM and dumps the validated VI scanout plus the ring state
# behind it. Pure observer — it never touches guest-visible state.
#
# Built from the framework's own source, not a copy: bench/frame_probe.c.
# ---------------------------------------------------------------------------
add_executable(@SLUG@-frame-probe "${N64LLE_ROOT}/bench/frame_probe.c")
target_include_directories(@SLUG@-frame-probe PRIVATE
  "${N64LLE_ROOT}/runtime/include" "${N64LLE_ISA_INC}")
target_link_libraries(@SLUG@-frame-probe PRIVATE ${N64LLE_LIBS})

# ---------------------------------------------------------------------------
# The host executable — ONE call. Every line of it lives in the framework
# (n64lle runtime/host/ + runtime/runtime.cmake, the contract docs/05 §10
# specifies), so this repo carries no host source at all and inherits host fixes
# on a submodule bump. Everything title-specific is read out of game.toml at
# runtime.
#
# @SLUG_UPPER@_BUILD_UI=OFF skips it; the gates and the frame probe are
# unaffected. So is a machine without SDL3 — the macro warns and declines rather
# than taking this project's gates down with it.
# ---------------------------------------------------------------------------
option(@SLUG_UPPER@_BUILD_UI "Build the recomp-ui launcher + host executable" ON)

if(@SLUG_UPPER@_BUILD_UI)
  n64lle_add_runtime_target(@SLUG@-runtime
    GAME_TOML   "${CMAKE_CURRENT_SOURCE_DIR}/game.toml"
    GEN_LIB     @SLUG@_gen
    OUTPUT_NAME @EXE@
    ROMS_DIR    "${CMAKE_CURRENT_SOURCE_DIR}/roms"
    RECOMP_UI   "${CMAKE_CURRENT_SOURCE_DIR}/recomp-ui")
endif()

if(TARGET @SLUG@-runtime)
  # THIS repo's contract, read by the real reader. The TOML subset itself is
  # gated in the framework (host_config_fixture); what is this project's to
  # prove is that its OWN game.toml resolves — so an edit into a shape the
  # reader cannot represent fails THIS build instead of falling back to a
  # default on a player's machine.
  add_test(NAME @SLUG@_contract COMMAND @SLUG@-runtime --check-config)
  set_tests_properties(@SLUG@_contract PROPERTIES
    PASS_REGULAR_EXPRESSION "CONTRACT_OK"
    FAIL_REGULAR_EXPRESSION "CONTRACT_FAIL" TIMEOUT 60)

  # The host itself: boot, present, screenshot, exit. Headless CI has no
  # display, so failing to open a window is a SKIP (77), the same convention the
  # ROM-absent gates use.
  add_test(NAME @SLUG@_host_smoke
    COMMAND @SLUG@-runtime "${@SLUG_UPPER@_ROM}" --no-launcher --mute --frames 30
            --screenshot "${CMAKE_CURRENT_BINARY_DIR}/@SLUG@_host_smoke.ppm")
  set_tests_properties(@SLUG@_host_smoke PROPERTIES
    ENVIRONMENT "SDL_VIDEODRIVER=offscreen;N64_RSP_EXEC=1"
    PASS_REGULAR_EXPRESSION "RUN_DONE" SKIP_RETURN_CODE 77 TIMEOUT 900)
endif()

message(STATUS "@PROJECT@ ${PROJECT_VERSION}: framework=${N64LLE_BUILD} "
               "rom=${@SLUG_UPPER@_ROM} harvest=${@SLUG_UPPER@_HARVEST_FRAMES}f "
               "host=${@SLUG_UPPER@_BUILD_UI}")
